{
  "name": "@wtf/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web app for WTF.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('coverage',{recursive:true,force:true})\"",
    "dev": "next dev --port 3000",
    "lint": "eslint .",
    "start": "next start --port 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@wtf/ui": "workspace:*",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "5.0.13",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.6",
    "tailwindcss": "4.3.0"
  }
}
