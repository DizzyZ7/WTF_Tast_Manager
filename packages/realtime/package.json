{
  "name": "@wtf/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "WebSocket and Yjs realtime collaboration layer for WTF.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('coverage',{recursive:true,force:true})\"",
    "dev": "tsc -b --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "ioredis": "5.10.1",
    "ws": "8.20.1",
    "yjs": "13.6.30",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.6"
  }
}
